#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
WellToken Price Dashboard (WPD) 控制台 CLI 工具
支持: wpd --restart, wpd --stop, wpd --status, wpd --start
"""

import os
import sys
import time
import signal
import socket
import subprocess
import urllib.request

PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FRONTEND_PORT = 5173
BACKEND_PORT = 8765
LOG_DIR = os.path.join(PROJECT_ROOT, ".logs")

# 彩色输出 ANSI 色值
GREEN = "\033[92m"
BLUE = "\033[94m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
RESET = "\033[0m"

def print_banner():
    print(f"{BLUE}{BOLD}======================================================{RESET}")
    print(f"{BLUE}{BOLD}      WellToken Price Dashboard CLI (wpd)             {RESET}")
    print(f"{BLUE}{BOLD}======================================================{RESET}")

def is_port_in_use(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.5)
        return s.connect_ex(('127.0.0.1', port)) == 0

def find_pids_by_port(port: int) -> list:
    try:
        output = subprocess.check_output(["lsof", "-ti", f":{port}"], stderr=subprocess.DEVNULL).decode().strip()
        if output:
            return [int(pid) for pid in output.split()]
    except Exception:
        pass
    return []

def kill_port_processes(port: int, name: str):
    pids = find_pids_by_port(port)
    if pids:
        print(f"{YELLOW}⏳ 正在停止 {name} 服务 (端口 {port}, PIDs: {pids})...{RESET}")
        for pid in pids:
            try:
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
        time.sleep(1)
        # 二次检查强制 kill -9
        remaining = find_pids_by_port(port)
        for pid in remaining:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
        print(f"{GREEN}✓ {name} 服务已完全停止，端口 {port} 已释放{RESET}")
    else:
        print(f"ℹ️ {name} 服务端口 {port} 未被占用")

def kill_all_services():
    kill_port_processes(FRONTEND_PORT, "前端 Vite (Web)")
    kill_port_processes(BACKEND_PORT, "后端 FastAPI (Server)")

def find_python_executable() -> str:
    candidates = [
        "python",
        os.path.expanduser("~/.pyenv/shims/python"),
        sys.executable,
        "python3"
    ]
    for c in candidates:
        if not c:
            continue
        try:
            res = subprocess.run([c, "-c", "import uvicorn, fastapi"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if res.returncode == 0:
                return c
        except Exception:
            pass
    return "python"

def start_backend():
    os.makedirs(LOG_DIR, exist_ok=True)
    backend_log = open(os.path.join(LOG_DIR, "backend.log"), "a")
    print(f"{BLUE}🚀 正在启动后端 FastAPI 服务 (端口 {BACKEND_PORT})...{RESET}")
    
    py_exec = find_python_executable()
    cmd = [py_exec, "backend/run_server.py", "--port", str(BACKEND_PORT), "--reload"]
    proc = subprocess.Popen(
        cmd,
        cwd=PROJECT_ROOT,
        stdout=backend_log,
        stderr=backend_log,
        env=dict(os.environ, PYTHONPATH=PROJECT_ROOT),
        start_new_session=True
    )
    
    # 等待后端健康就绪
    for _ in range(30):
        time.sleep(0.3)
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{BACKEND_PORT}/", timeout=1) as resp:
                if resp.status == 200:
                    print(f"{GREEN}✓ 后端服务启动成功！API 地址: http://127.0.0.1:{BACKEND_PORT}{RESET}")
                    return proc
        except Exception:
            pass
    print(f"{YELLOW}⚠️ 后端服务已拉起 (PID: {proc.pid})，正在初始化数据...{RESET}")
    return proc

def start_frontend():
    os.makedirs(LOG_DIR, exist_ok=True)
    frontend_log = open(os.path.join(LOG_DIR, "frontend.log"), "a")
    print(f"{BLUE}🚀 正在启动前端 Vite 开发服务器 (端口 {FRONTEND_PORT})...{RESET}")
    
    cmd = ["npx", "vite", "--host", "0.0.0.0", "--port", str(FRONTEND_PORT)]
    proc = subprocess.Popen(
        cmd,
        cwd=PROJECT_ROOT,
        stdout=frontend_log,
        stderr=frontend_log,
        start_new_session=True
    )
    
    # 等待前端就绪
    for _ in range(30):
        time.sleep(0.3)
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{FRONTEND_PORT}/", timeout=1) as resp:
                if resp.status == 200:
                    print(f"{GREEN}✓ 前端服务启动成功！浏览器访问: http://localhost:{FRONTEND_PORT}/{RESET}")
                    return proc
        except Exception:
            pass
    print(f"{GREEN}✓ 前端服务已拉起 (PID: {proc.pid}){RESET}")
    return proc

def show_status():
    print_banner()
    b_pids = find_pids_by_port(BACKEND_PORT)
    f_pids = find_pids_by_port(FRONTEND_PORT)
    
    print("📊 当前服务运行状态：")
    if b_pids:
        print(f"  • 后端 FastAPI 服务: {GREEN}● 运行中{RESET} (端口 {BACKEND_PORT}, PID: {b_pids})")
    else:
        print(f"  • 后端 FastAPI 服务: {RED}○ 已停止{RESET}")
        
    if f_pids:
        print(f"  • 前端 Vite 服务:   {GREEN}● 运行中{RESET} (端口 {FRONTEND_PORT}, PID: {f_pids})")
        print(f"    👉 访问链接: {BOLD}http://localhost:{FRONTEND_PORT}/{RESET}")
    else:
        print(f"  • 前端 Vite 服务:   {RED}○ 已停止{RESET}")
    print()

def restart_all():
    print_banner()
    print(f"{BOLD}🔄 开始执行 WPD 全局服务重启 (Kill & Restart)...{RESET}\n")
    kill_all_services()
    time.sleep(1)
    print()
    start_backend()
    time.sleep(0.5)
    start_frontend()
    print()
    print(f"{GREEN}{BOLD}🎉 全部服务重启完成！{RESET}")
    print(f"👉 浏览器直达: {BLUE}{BOLD}http://localhost:{FRONTEND_PORT}/{RESET} 或 {BLUE}{BOLD}http://127.0.0.1:{FRONTEND_PORT}/{RESET}")
    print(f"{BLUE}======================================================{RESET}")

def main():
    args = sys.argv[1:]
    if not args or "--restart" in args or "restart" in args:
        restart_all()
    elif "--stop" in args or "stop" in args:
        print_banner()
        kill_all_services()
        print(f"{GREEN}✓ 全部 WPD 服务已停止。{RESET}")
    elif "--status" in args or "status" in args:
        show_status()
    elif "--start" in args or "start" in args:
        print_banner()
        start_backend()
        start_frontend()
        print(f"\n👉 浏览器访问: {BLUE}{BOLD}http://localhost:{FRONTEND_PORT}/{RESET}")
    else:
        print(f"未知参数: {args}")
        print("使用说明:")
        print("  wpd --restart   # 终止当前进程并重启前端与后端服务")
        print("  wpd --stop      # 停止所有前端与后端服务")
        print("  wpd --status    # 查看服务当前运行状态")
        print("  wpd --start     # 启动前端与后端服务")

if __name__ == "__main__":
    main()
