        <Shape id="nav-text-4-active" type="Evolus.Common:PlainText" x="22" y="205" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#38BDF8;font-size:12px;font-weight:bold;">⏱️ 渠道性能实测</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 顶部测速控制台面板 -->
        <Shape id="test-control-04" type="Evolus.Common:Rectangle" x="215" y="15" width="1050" height="135">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="test-control-content-04" type="Evolus.Common:PlainText" x="230" y="28" width="1020" height="110">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:13px;font-weight:bold;">⚡ 测速配置 (兼容 OpenAI / Anthropic SSE 流式协议)</span><br/><br/><span style="color:#9CA3AF;font-size:11px;">测试目标渠道: </span><span style="background-color:#111827;color:#fff;padding:3px 8px;border-radius:4px;font-size:11px;">[✓ 全部已勾选 8 家中转渠道]</span> <span style="color:#9CA3AF;font-size:11px;margin-left:15px;">测试模型: </span><span style="background-color:#111827;color:#60A5FA;padding:3px 8px;border-radius:4px;font-size:11px;font-family:monospace;">deepseek-v3</span> <span style="color:#9CA3AF;font-size:11px;margin-left:15px;">Prompt 模板: </span><span style="background-color:#111827;color:#fff;padding:3px 8px;border-radius:4px;font-size:11px;">标准 500 字生成 + 真实性防作弊探针</span><br/><br/><span style="color:#9CA3AF;font-size:11px;">测试轮数: </span><span style="background-color:#111827;color:#fff;padding:2px 6px;border-radius:4px;font-size:11px;">3 轮采样</span> <span style="color:#9CA3AF;font-size:11px;margin-left:15px;">并发线程: </span><span style="background-color:#111827;color:#fff;padding:2px 6px;border-radius:4px;font-size:11px;">4 并发</span> <span style="margin-left:25px;background-color:#10B981;color:#fff;padding:6px 20px;border-radius:6px;font-size:12px;font-weight:bold;cursor:pointer;">▶ 开始批量并发实测</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 实时流式指标卡片 -->
        <Shape id="card-metric-1" type="Evolus.Common:Rectangle" x="215" y="162" width="245" height="95">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="card-metric-1-content" type="Evolus.Common:PlainText" x="228" y="172" width="220" height="75">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;">首字延迟 (TTFT) 均值</span><br/><span style="color:#10B981;font-size:24px;font-weight:bold;font-family:monospace;">248</span> <span style="color:#9CA3AF;font-size:12px;">ms</span><br/><span style="color:#6B7280;font-size:10px;">最优: 142ms (极速云) | P95: 390ms</span>]]></Property>
          </Properties>
        </Shape>

        <Shape id="card-metric-2" type="Evolus.Common:Rectangle" x="480" y="162" width="245" height="95">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="card-metric-2-content" type="Evolus.Common:PlainText" x="493" y="172" width="220" height="75">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;">平均生成速率 (TPS)</span><br/><span style="color:#38BDF8;font-size:24px;font-weight:bold;font-family:monospace;">58.4</span> <span style="color:#9CA3AF;font-size:12px;">tokens/s</span><br/><span style="color:#6B7280;font-size:10px;">峰值 (10-Token窗口): 76.2 tps</span>]]></Property>
          </Properties>
        </Shape>

        <Shape id="card-metric-3" type="Evolus.Common:Rectangle" x="745" y="162" width="245" height="95">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="card-metric-3-content" type="Evolus.Common:PlainText" x="758" y="172" width="220" height="75">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;">模型一致性探针</span><br/><span style="color:#34D399;font-size:20px;font-weight:bold;">100% 真实</span><br/><span style="color:#6B7280;font-size:10px;">未发现降级/掺水/缓存截获</span>]]></Property>
          </Properties>
        </Shape>

        <Shape id="card-metric-4" type="Evolus.Common:Rectangle" x="1010" y="162" width="255" height="95">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="card-metric-4-content" type="Evolus.Common:PlainText" x="1023" y="172" width="230" height="75">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;">网络成功率 (Availability)</span><br/><span style="color:#10B981;font-size:24px;font-weight:bold;font-family:monospace;">99.4%</span><br/><span style="color:#6B7280;font-size:10px;">测试 160 请求 | 失败 1 次</span>]]></Property>
          </Properties>
        </Shape>

        <!-- TPS 流式动态折线图与排行榜 -->
        <Shape id="chart-card-04" type="Evolus.Common:Rectangle" x="215" y="270" width="600" height="530">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="chart-content-04" type="Evolus.Common:PlainText" x="230" y="285" width="570" height="500">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:13px;font-weight:bold;">📊 实时流式 TPS 速率与首字延迟波动曲线 (ECharts)</span><br/><br/><span style="color:#6B7280;font-size:11px;font-family:monospace;">[ 动态折线图展示各中转渠道在流式输出过程中的 Token 间隔平稳度 ]<br/>- 极速云 (NewAPI): 绿色曲线, TTFT 142ms, TPS 均值 61.2<br/>- 星河中转 (Sub2API): 紫色曲线, TTFT 210ms, TPS 均值 54.8<br/>- 官方直连: 蓝色曲线, TTFT 180ms, TPS 均值 64.0<br/><br/>★ 抖动率检测 (Jitter): 极速云 (4.2%) 稳定性评级 S 级</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 右侧测速排行榜与打分表 -->
        <Shape id="rank-card-04" type="Evolus.Common:Rectangle" x="830" y="270" width="435" height="530">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="rank-content-04" type="Evolus.Common:PlainText" x="845" y="285" width="405" height="500">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:13px;font-weight:bold;">🏆 渠道综合性能排行榜 (Score Matrix)</span><br/><br/><span style="color:#F59E0B;font-weight:bold;font-size:12px;">🥇 第 1 名: 极速云中转 (NewAPI)</span><br/><span style="color:#9CA3AF;font-size:11px;">  综合评分: </span><span style="color:#34D399;font-weight:bold;font-size:12px;">98.2 分 (S级)</span><br/><span style="color:#9CA3AF;font-size:11px;">  TTFT: 142ms | TPS: 61.2 | 折扣: -50% | 一致性: 100%</span><br/><br/><span style="color:#D1D5DB;font-weight:bold;font-size:12px;">🥈 第 2 名: DeepSeek 官方直连</span><br/><span style="color:#9CA3AF;font-size:11px;">  综合评分: </span><span style="color:#34D399;font-weight:bold;font-size:12px;">96.5 分 (S级)</span><br/><span style="color:#9CA3AF;font-size:11px;">  TTFT: 180ms | TPS: 64.0 | 折扣: 0% | 一致性: 100%</span><br/><br/><span style="color:#B45309;font-weight:bold;font-size:12px;">🥉 第 3 名: 星河 AI (Sub2API)</span><br/><span style="color:#9CA3AF;font-size:11px;">  综合评分: </span><span style="color:#60A5FA;font-weight:bold;font-size:12px;">91.0 分 (A级)</span><br/><span style="color:#9CA3AF;font-size:11px;">  TTFT: 210ms | TPS: 54.8 | 折扣: -40% | 一致性: 100%</span><br/><br/><span style="background-color:#2563EB;color:#fff;padding:4px 12px;border-radius:4px;font-size:11px;">导出 HTML / PDF 测评报告</span>]]></Property>
          </Properties>
        </Shape>
      </Content>
    </Page>

    <!-- ========================================== -->
    <!-- Page 5: 数据同步与设置中心 -->
    <!-- ========================================== -->
    <Page id="page-sync-settings" width="1280" height="820">
      <Properties>
        <Property name="name">05_数据同步与设置中心</Property>
      </Properties>
      <Content>
        <Shape id="bg-05" type="Desktop:SolidBackground" x="0" y="0" width="1280" height="820">
          <Properties>
            <Property name="fillColor">#0B0E14FF</Property>
          </Properties>
        </Shape>
        <Shape id="sidebar-05" type="Evolus.Common:Rectangle" x="0" y="0" width="200" height="820">
          <Properties>
            <Property name="fillColor">#0F121AFF</Property>
            <Property name="strokeColor">#1F2430FF</Property>
          </Properties>
        </Shape>
        <Shape id="nav-item-5-active" type="Evolus.Common:Rectangle" x="10" y="235" width="180" height="38">
          <Properties>
            <Property name="fillColor">#1E293BFF</Property>
            <Property name="strokeColor">#3B82F688</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="nav-text-5-active" type="Evolus.Common:PlainText" x="22" y="245" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#38BDF8;font-size:12px;font-weight:bold;">⚙️ 数据同步与设置</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 主设置工作区 -->
        <Shape id="settings-card-1" type="Evolus.Common:Rectangle" x="215" y="15" width="1050" height="250">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="settings-card-1-content" type="Evolus.Common:PlainText" x="230" y="30" width="1020" height="220">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:14px;font-weight:bold;">🔄 数据源自动同步调度设置</span><br/><br/><span style="color:#E5E7EB;font-size:12px;font-weight:bold;">1. models.dev 官方基准模型数据源:</span><br/><span style="color:#9CA3AF;font-size:11px;">  API 地址: </span><span style="color:#60A5FA;font-family:monospace;font-size:11px;">https://models.dev/api.json</span><br/><span style="color:#9CA3AF;font-size:11px;">  自动同步频率: </span><span style="background-color:#111827;color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;">每日凌晨 03:00 自动拉取</span> <span style="background-color:#2563EB;color:#fff;padding:3px 10px;border-radius:4px;font-size:11px;margin-left:15px;cursor:pointer;">立即全量同步</span><br/><br/><span style="color:#E5E7EB;font-size:12px;font-weight:bold;">2. relaywatch / 中转渠道倍率数据同步:</span><br/><span style="color:#9CA3AF;font-size:11px;">  自动扫描并探测各中转站 /api/models 与价格端点: </span><span style="color:#34D399;font-size:11px;">[✓ 已启用]</span><br/><span style="color:#9CA3AF;font-size:11px;">  渠道轮询周期: </span><span style="background-color:#111827;color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;">每 60 分钟</span> <span style="color:#9CA3AF;font-size:11px;margin-left:10px;">并发探测线程: 5</span> <span style="background-color:#2563EB;color:#fff;padding:3px 10px;border-radius:4px;font-size:11px;margin-left:15px;cursor:pointer;">立即扫描全部中转站</span>]]></Property>
          </Properties>
        </Shape>

        <Shape id="settings-card-2" type="Evolus.Common:Rectangle" x="215" y="280" width="1050" height="250">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="settings-card-2-content" type="Evolus.Common:PlainText" x="230" y="295" width="1020" height="220">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:14px;font-weight:bold;">💱 汇率折算与通用参数</span><br/><br/><span style="color:#E5E7EB;font-size:12px;font-weight:bold;">1. 实时汇率配置:</span><br/><span style="color:#9CA3AF;font-size:11px;">  当前 USD / CNY 基准汇率: </span><span style="background-color:#111827;color:#34D399;padding:3px 10px;border-radius:4px;font-family:monospace;font-size:12px;font-weight:bold;">7.3000</span> <span style="color:#9CA3AF;font-size:11px;margin-left:10px;">[✓ 自动从公开汇率接口实时更新]</span><br/><br/><span style="color:#E5E7EB;font-size:12px;font-weight:bold;">2. SQLite 本地价格大数据库维护:</span><br/><span style="color:#9CA3AF;font-size:11px;">  数据库文件路径: </span><span style="color:#60A5FA;font-family:monospace;font-size:11px;">./data/welltoken.db (当前大小: 4.2 MB)</span><br/><span style="color:#9CA3AF;font-size:11px;">  历史价格快照数: </span><span style="color:#fff;font-size:11px;font-weight:bold;">32,450 条</span> <span style="color:#9CA3AF;font-size:11px;margin-left:15px;">测速历史记录: </span><span style="color:#fff;font-size:11px;font-weight:bold;">1,280 次</span><br/><br/><span style="background-color:#1E293B;color:#93C5FD;padding:4px 12px;border-radius:4px;font-size:11px;border:1px solid #3B82F6;">备份大数据库</span> <span style="background-color:#1E293B;color:#93C5FD;padding:4px 12px;border-radius:4px;font-size:11px;border:1px solid #3B82F6;margin-left:10px;">导出 Excel 比价总表</span> <span style="background-color:#7F1D1D;color:#FECACA;padding:4px 12px;border-radius:4px;font-size:11px;margin-left:10px;">清理 30 天前过期测速数据</span>]]></Property>
          </Properties>
        </Shape>
      </Content>
    </Page>
  </Pages>
</Document>
