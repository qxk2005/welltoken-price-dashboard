<?xml version="1.0" encoding="UTF-8"?>
<Document xmlns="http://www.evolus.vn/Pencil" xmlns:pencil="http://www.evolus.vn/Pencil" xmlns:html="http://www.w3.org/1999/xhtml" xmlns:svg="http://www.w3.org/2000/svg">
  <Properties>
    <Property name="author">WellToken Team</Property>
    <Property name="description">Token聚合比价与测评工具 (welltoken-price-dashboard) UI 交互设计原型</Property>
    <Property name="version">1.0.0</Property>
  </Properties>
  <Pages>
    <!-- ========================================== -->
    <!-- Page 1: 全网大模型聚合比价中心 -->
    <!-- ========================================== -->
    <Page id="page-price-matrix" width="1280" height="820">
      <Properties>
        <Property name="name">01_全网大模型聚合比价中心</Property>
      </Properties>
      <Content>
        <!-- 背景底色 -->
        <Shape id="bg-01" type="Desktop:SolidBackground" x="0" y="0" width="1280" height="820">
          <Properties>
            <Property name="fillColor">#0B0E14FF</Property>
          </Properties>
        </Shape>

        <!-- 顶部主状态与控制栏 -->
        <Shape id="topbar-01" type="Evolus.Common:Rectangle" x="0" y="0" width="1280" height="56">
          <Properties>
            <Property name="fillColor">#11151FFF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="strokeStyle">solid</Property>
          </Properties>
        </Shape>
        <!-- Logo -->
        <Shape id="logo-icon-01" type="Evolus.Common:Rectangle" x="16" y="12" width="32" height="32">
          <Properties>
            <Property name="fillColor">#2563EBFF</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="logo-text-01" type="Evolus.Common:PlainText" x="56" y="14" width="220" height="24">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-weight:bold;font-size:14px;">WellToken</span> <span style="color:#3B82F6;font-size:11px;font-family:monospace;background-color:#1E293B;padding:2px 4px;border-radius:4px;">比价与测评 Pro</span>]]></Property>
          </Properties>
        </Shape>
        <Shape id="status-badge-01" type="Evolus.Common:PlainText" x="56" y="34" width="300" height="18">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#10B981;font-size:10px;">● models.dev 数据已同步</span> <span style="color:#6B7280;font-size:10px;">| 监控中转站: 18家 | 官方基准模型: 142款</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 全局搜索框 -->
        <Shape id="search-box-01" type="Evolus.Common:Rectangle" x="420" y="12" width="360" height="32">
          <Properties>
            <Property name="fillColor">#1A202CFF</Property>
            <Property name="strokeColor">#2D3748FF</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="search-text-01" type="Evolus.Common:PlainText" x="432" y="20" width="330" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;">🔍 搜索模型 (如 gpt-4o, claude-3-5, deepseek-v3) 或中转站... [⌘K]</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 汇率切换与同步按钮 -->
        <Shape id="btn-currency-01" type="Evolus.Common:Rectangle" x="1050" y="12" width="90" height="32">
          <Properties>
            <Property name="fillColor">#1E2430FF</Property>
            <Property name="strokeColor">#374151FF</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="btn-currency-text-01" type="Evolus.Common:PlainText" x="1060" y="20" width="70" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#F3F4F6;font-size:11px;font-weight:bold;">💵 USD / ￥ CNY</span>]]></Property>
          </Properties>
        </Shape>
        <Shape id="btn-sync-01" type="Evolus.Common:Rectangle" x="1150" y="12" width="110" height="32">
          <Properties>
            <Property name="fillColor">#2563EBFF</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="btn-sync-text-01" type="Evolus.Common:PlainText" x="1165" y="20" width="85" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:11px;font-weight:bold;">⚡ 一键刷新比价</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 左侧主导航菜单 -->
        <Shape id="sidebar-01" type="Evolus.Common:Rectangle" x="0" y="56" width="200" height="764">
          <Properties>
            <Property name="fillColor">#0F121AFF</Property>
            <Property name="strokeColor">#1F2430FF</Property>
            <Property name="strokeStyle">solid</Property>
          </Properties>
        </Shape>
        <!-- 导航项：1. 全网比价中心 (Active) -->
        <Shape id="nav-item-1-01" type="Evolus.Common:Rectangle" x="10" y="70" width="180" height="38">
          <Properties>
            <Property name="fillColor">#1E293BFF</Property>
            <Property name="strokeColor">#3B82F688</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="nav-text-1-01" type="Evolus.Common:PlainText" x="22" y="80" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#38BDF8;font-size:12px;font-weight:bold;">📊 全网聚合比价</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 导航项：2. 渠道大全 -->
        <Shape id="nav-item-2-01" type="Evolus.Common:PlainText" x="22" y="125" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:12px;">🌐 Token 渠道大全</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 导航项：3. 厂商与模型 -->
        <Shape id="nav-item-3-01" type="Evolus.Common:PlainText" x="22" y="165" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:12px;">🤖 模型厂商与标准库</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 导航项：4. 性能实测 -->
        <Shape id="nav-item-4-01" type="Evolus.Common:PlainText" x="22" y="205" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:12px;">⏱️ 渠道性能实测</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 导航项：5. 数据同步与设置 -->
        <Shape id="nav-item-5-01" type="Evolus.Common:PlainText" x="22" y="245" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:12px;">⚙️ 数据同步与设置</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 主工作区：顶部筛选与卡片 -->
        <!-- 筛选栏 -->
        <Shape id="filter-bar-01" type="Evolus.Common:Rectangle" x="215" y="68" width="1050" height="46">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="filter-text-01" type="Evolus.Common:PlainText" x="230" y="82" width="1020" height="24">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;font-weight:bold;">厂商筛选:</span> <span style="background-color:#2563EB;color:#fff;padding:2px 8px;border-radius:4px;font-size:11px;">全部厂商</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">OpenAI</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">Anthropic</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">DeepSeek</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">Google</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">阿里通义</span> <span style="color:#6B7280;margin-left:20px;">|</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:12px;">热点模型:</span> <span style="color:#60A5FA;font-size:11px;">GPT-4o</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">Claude 3.5 Sonnet</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">DeepSeek-V3</span> <span style="color:#D1D5DB;font-size:11px;margin-left:8px;">DeepSeek-R1</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 价格比对核心数据表格 (Data Matrix) -->
        <Shape id="table-bg-01" type="Evolus.Common:Rectangle" x="215" y="125" width="1050" height="480">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <!-- 表头 -->
        <Shape id="table-header-01" type="Evolus.Common:Rectangle" x="216" y="126" width="1048" height="36">
          <Properties>
            <Property name="fillColor">#1B212DFF</Property>
          </Properties>
        </Shape>
        <Shape id="th-text-01" type="Evolus.Common:PlainText" x="230" y="136" width="1020" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#9CA3AF;font-size:11px;font-weight:bold;">模型标准名称</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:140px;">渠道 / 站点名称</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:90px;">类型</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:60px;">输入 (Input/1M)</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:45px;">输出 (Output/1M)</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:40px;">缓存命中/1M</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:40px;">折算倍率</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:40px;">比官方价折扣</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:40px;">实测 TPS</span> <span style="color:#9CA3AF;font-size:11px;font-weight:bold;margin-left:35px;">操作</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 数据行 1: DeepSeek-V3 (官方基准) -->
        <Shape id="row-1-01" type="Evolus.Common:PlainText" x="230" y="172" width="1020" height="26">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#60A5FA;font-weight:bold;font-size:12px;">deepseek-v3</span> <span style="color:#F3F4F6;font-size:12px;margin-left:135px;">DeepSeek 官方 API</span> <span style="background-color:#1E293B;color:#94A3B8;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:70px;">官方原厂</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:55px;">$0.14 / ￥1.00</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:55px;">$0.28 / ￥2.00</span> <span style="color:#9CA3AF;font-family:monospace;font-size:12px;margin-left:55px;">$0.014 / ￥0.10</span> <span style="color:#E5E7EB;font-size:11px;margin-left:60px;">1.00x 基准</span> <span style="color:#9CA3AF;font-size:11px;margin-left:50px;">基准价 (0%)</span> <span style="color:#38BDF8;font-family:monospace;font-size:11px;margin-left:50px;">62.4 tps</span> <span style="color:#3B82F6;font-size:11px;margin-left:40px;">[测速] [详情]</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 数据行 2: DeepSeek-V3 (中转站 A - NewAPI 架构) -->
        <Shape id="row-2-01" type="Evolus.Common:PlainText" x="230" y="210" width="1020" height="26">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#60A5FA;font-weight:bold;font-size:12px;">deepseek-v3</span> <span style="color:#F3F4F6;font-size:12px;margin-left:135px;">极速云中转 (NewAPI)</span> <span style="background-color:#064E3B;color:#34D399;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:65px;">NewAPI</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:60px;">$0.07 / ￥0.50</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:55px;">$0.14 / ￥1.00</span> <span style="color:#9CA3AF;font-family:monospace;font-size:12px;margin-left:55px;">$0.007 / ￥0.05</span> <span style="color:#E5E7EB;font-size:11px;margin-left:60px;">0.50x 特惠</span> <span style="background-color:#065F46;color:#34D399;padding:1px 4px;border-radius:3px;font-size:10px;margin-left:45px;">▼ -50% 折扣</span> <span style="color:#38BDF8;font-family:monospace;font-size:11px;margin-left:35px;">58.9 tps</span> <span style="color:#3B82F6;font-size:11px;margin-left:40px;">[测速] [详情]</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 数据行 3: Claude 3.5 Sonnet (官方基准) -->
        <Shape id="row-3-01" type="Evolus.Common:PlainText" x="230" y="248" width="1020" height="26">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#A78BFA;font-weight:bold;font-size:12px;">claude-3-5-sonnet</span> <span style="color:#F3F4F6;font-size:12px;margin-left:90px;">Anthropic 官方直连</span> <span style="background-color:#1E293B;color:#94A3B8;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:65px;">官方原厂</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:55px;">$3.00 / ￥21.9</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:50px;">$15.00 / ￥109.5</span> <span style="color:#9CA3AF;font-family:monospace;font-size:12px;margin-left:40px;">$0.30 / ￥2.19</span> <span style="color:#E5E7EB;font-size:11px;margin-left:55px;">1.00x 基准</span> <span style="color:#9CA3AF;font-size:11px;margin-left:50px;">基准价 (0%)</span> <span style="color:#38BDF8;font-family:monospace;font-size:11px;margin-left:50px;">45.2 tps</span> <span style="color:#3B82F6;font-size:11px;margin-left:40px;">[测速] [详情]</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 数据行 4: Claude 3.5 Sonnet (Sub2API 渠道 B) -->
        <Shape id="row-4-01" type="Evolus.Common:PlainText" x="230" y="286" width="1020" height="26">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#A78BFA;font-weight:bold;font-size:12px;">claude-3-5-sonnet</span> <span style="color:#F3F4F6;font-size:12px;margin-left:90px;">星河中转站 (Sub2API)</span> <span style="background-color:#4C1D95;color:#C4B5FD;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:55px;">Sub2API</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:55px;">$1.80 / ￥13.1</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:50px;">$9.00 / ￥65.70</span> <span style="color:#9CA3AF;font-family:monospace;font-size:12px;margin-left:45px;">$0.18 / ￥1.31</span> <span style="color:#E5E7EB;font-size:11px;margin-left:55px;">0.60x 优惠</span> <span style="background-color:#065F46;color:#34D399;padding:1px 4px;border-radius:3px;font-size:10px;margin-left:45px;">▼ -40% 折扣</span> <span style="color:#38BDF8;font-family:monospace;font-size:11px;margin-left:35px;">41.8 tps</span> <span style="color:#3B82F6;font-size:11px;margin-left:40px;">[测速] [详情]</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 数据行 5: GPT-4o (官方基准) -->
        <Shape id="row-5-01" type="Evolus.Common:PlainText" x="230" y="324" width="1020" height="26">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#34D399;font-weight:bold;font-size:12px;">gpt-4o</span> <span style="color:#F3F4F6;font-size:12px;margin-left:175px;">OpenAI 官方原厂</span> <span style="background-color:#1E293B;color:#94A3B8;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:70px;">官方原厂</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:55px;">$2.50 / ￥18.2</span> <span style="color:#10B981;font-family:monospace;font-size:12px;margin-left:50px;">$10.00 / ￥73.0</span> <span style="color:#9CA3AF;font-family:monospace;font-size:12px;margin-left:45px;">$1.25 / ￥9.12</span> <span style="color:#E5E7EB;font-size:11px;margin-left:55px;">1.00x 基准</span> <span style="color:#9CA3AF;font-size:11px;margin-left:50px;">基准价 (0%)</span> <span style="color:#38BDF8;font-family:monospace;font-size:11px;margin-left:50px;">88.5 tps</span> <span style="color:#3B82F6;font-size:11px;margin-left:40px;">[测速] [详情]</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 底部走势与性价比分析面板 -->
        <Shape id="chart-card-01" type="Evolus.Common:Rectangle" x="215" y="618" width="1050" height="185">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="chart-title-01" type="Evolus.Common:PlainText" x="230" y="628" width="500" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:12px;font-weight:bold;">📈 全网各渠道价格与性能分布散点图 (当前选中: deepseek-v3)</span>]]></Property>
          </Properties>
        </Shape>
        <Shape id="chart-placeholder-01" type="Evolus.Common:PlainText" x="350" y="680" width="800" height="80">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#6B7280;font-size:12px;font-family:monospace;">[ ECharts 性价比图表区：X轴=输入单价($/1M), Y轴=实测TPS(tokens/s), 气泡大小=稳定性评分, 颜色=渠道类别 ]<br/><br/>★ 最优性价比推荐: 极速云中转 (单价 $0.07 / 58.9 tps) | 官方基准: DeepSeek ($0.14 / 62.4 tps)</span>]]></Property>
          </Properties>
        </Shape>
      </Content>
    </Page>

    <!-- ========================================== -->
    <!-- Page 2: Token 渠道大全与配置管理 -->
    <!-- ========================================== -->
    <Page id="page-channel-mgmt" width="1280" height="820">
      <Properties>
        <Property name="name">02_Token渠道大全与配置管理</Property>
      </Properties>
      <Content>
        <Shape id="bg-02" type="Desktop:SolidBackground" x="0" y="0" width="1280" height="820">
          <Properties>
            <Property name="fillColor">#0B0E14FF</Property>
          </Properties>
        </Shape>
        <!-- 侧边栏 -->
        <Shape id="sidebar-02" type="Evolus.Common:Rectangle" x="0" y="0" width="200" height="820">
          <Properties>
            <Property name="fillColor">#0F121AFF</Property>
            <Property name="strokeColor">#1F2430FF</Property>
          </Properties>
        </Shape>
        <Shape id="nav-item-2-active" type="Evolus.Common:Rectangle" x="10" y="115" width="180" height="38">
          <Properties>
            <Property name="fillColor">#1E293BFF</Property>
            <Property name="strokeColor">#3B82F688</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="nav-text-2-active" type="Evolus.Common:PlainText" x="22" y="125" width="160" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#38BDF8;font-size:12px;font-weight:bold;">🌐 Token 渠道大全</span>]]></Property>
          </Properties>
        </Shape>

        <!-- 顶部操作栏 -->
        <Shape id="action-bar-02" type="Evolus.Common:Rectangle" x="215" y="15" width="1050" height="52">
          <Properties>
            <Property name="fillColor">#151922FF</Property>
            <Property name="strokeColor">#232936FF</Property>
            <Property name="radius">8</Property>
          </Properties>
        </Shape>
        <Shape id="action-title-02" type="Evolus.Common:PlainText" x="230" y="30" width="300" height="24">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:14px;font-weight:bold;">已配置中转渠道 (共 18 家)</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 添加渠道按钮 -->
        <Shape id="btn-add-channel-02" type="Evolus.Common:Rectangle" x="980" y="25" width="130" height="32">
          <Properties>
            <Property name="fillColor">#2563EBFF</Property>
            <Property name="radius">6</Property>
          </Properties>
        </Shape>
        <Shape id="btn-add-text-02" type="Evolus.Common:PlainText" x="995" y="32" width="105" height="20">
          <Properties>
            <Property name="text"><![CDATA[<span style="color:#ffffff;font-size:11px;font-weight:bold;">+ 新增中转渠道</span>]]></Property>
          </Properties>
        </Shape>
        <!-- 批量检测连通性 -->
        <Shape id="btn-ping-all-02" type="Evolus.Common:Rectangle" x="1120" y="25" width="130" height="32">
          <Properties>
            <Property name="fillColor">#1E2430FF</Property>
            <Property name="strokeColor">#374151FF</Property>
            <Property name="radius">6</Property>
