{
  "name": "welltoken-price-dashboard",
  "version": "1.3.2",
  "description": "Cross-platform Token & Crypto Price Dashboard built with Electron, Vue 3, SQLite and Python FastAPI",
  "main": "./out/main/index.js",
  "author": "qxk2005",
  "homepage": "https://github.com/qxk2005/welltoken-price-dashboard",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:browser": "vite",
    "dev:web": "vite",
    "dev:server": "python backend/run_server.py --port 8765 --reload",
    "wpd": "./bin/wpd",
    "restart": "./bin/wpd --restart",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:backend": "pyinstaller pyinstaller.spec --distpath resources/bin --clean",
    "build:all": "npm run build:backend && electron-vite build && electron-builder",
    "build:mac": "npm run build:backend && electron-vite build && electron-builder --mac",
    "build:win": "npm run build:backend && electron-vite build && electron-builder --win",
    "release:sync": "bash ./scripts/release_sync.sh",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "screenshot": "node scripts/screenshot_tester.mjs",
    "test:ui": "node scripts/screenshot_tester.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "axios": "^1.6.8",
    "echarts": "^5.5.0",
    "lucide-vue-next": "^0.363.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.3",
    "vite": "^5.1.6",
    "vue-tsc": "^2.0.7"
  },
  "build": {
    "appId": "com.welltoken.pricedashboard",
    "productName": "WellToken Price Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
