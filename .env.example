# ==========================================
# WellToken Price Dashboard - Environment Config Example
# ==========================================

# 后端微服务配置
APP_NAME=WellToken-Price-Dashboard
APP_ENV=development
DEBUG=true
SERVER_HOST=127.0.0.1
SERVER_PORT=8765

# 数据库配置 (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/welltoken.db

# 数据采集与行情更新间隔 (秒)
PRICE_FETCH_INTERVAL=5

# 外部行情 API 配置 (可选扩展)
CRYPTO_API_ENDPOINT=https://api.coingecko.com/api/v3
CRYPTO_API_KEY=your_optional_api_key_here
COINMARKETCAP_API_KEY=your_optional_cmc_key_here

# 安全与通信密钥 (用于生产环境 IPC/Token 鉴权)
SECRET_KEY=generate_a_secure_random_key_for_production
