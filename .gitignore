# ==========================================
# WellToken Price Dashboard - .gitignore
# ==========================================

# -----------------
# 1. 运行环境与敏感配置 (Secrets & Environments)
# -----------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx
secrets/
config/local.json

# -----------------
# 2. Python 相关构建与缓存 (Python Cache & Virtualenv)
# -----------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------
# 3. Node.js & 前端构建 (Node.js & Frontend Build Artifacts)
# -----------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
*.local
out/
release/
.vite/
.output/

# -----------------
# 4. Electron & 跨平台构建产物 (Electron Builds & Binaries)
# -----------------
resources/bin/*
!resources/bin/.gitkeep
*.dmg
*.exe
*.pkg
*.deb
*.rpm
*.AppImage
*.snap
*.blockmap
*.zip
*.tar.gz

# -----------------
# 5. 本地数据库与日志文件 (SQLite Database & Runtime Logs)
# -----------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*
!data/cache/
!data/cache/*.json
!data/cache/.gitkeep
!data/official_prices_seed.json
logs/
*.log

# -----------------
# 6. 系统临时文件与编辑器配置 (OS & IDE Artifacts)
# -----------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# VS Code (保留推荐扩展与设置，忽略个人状态)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log
